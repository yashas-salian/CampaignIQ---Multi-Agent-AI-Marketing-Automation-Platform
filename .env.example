# --- Free tier (required — the system runs fully on these, no cost) ---
GROQ_API_KEY=
NEWSAPI_KEY=

# Optional free-tier LLM fallbacks, tried in this order when Groq is
# rate-limited or down (src/providers/gateway.py). All free, all optional:
#   Cerebras   https://cloud.cerebras.ai     (same gpt-oss-120b model)
#   OpenRouter https://openrouter.ai/keys     (gpt-oss-120b:free)
#   Gemini     https://aistudio.google.com/apikey (gemini-2.5-flash)
# Override a model with CEREBRAS_MODEL / OPENROUTER_MODEL / GEMINI_MODEL.
# Kill switch for the whole chain: FLAG_LLM_FALLBACK=false.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Ad images on the free tier (src/providers/registry.py::_free_image), tried in
# this order, each failure handing over to the next:
#   0. OpenAI gpt-image-2 with OPENAI_API_KEY, ONLY when OPENAI_IMAGE_GEN=on
#      (off by default to save its credit; in CI it's the repo variable
#      OPENAI_IMAGE_GEN, the key the secret OPENAI_API_KEY).
#   1. FLUX.1-schnell on Cloudflare Workers AI: CLOUDFLARE_ACCOUNT_ID and
#      CLOUDFLARE_API_TOKEN (Workers AI read + edit). Free daily allowance.
#   1b. FLUX.1-schnell on Hugging Face Inference: HF_TOKEN (below) must have the
#      "Make calls to Inference Providers" permission. Small free monthly credit.
#   2. Gemini (GEMINI_API_KEY above): image models have no free tier, so this
#      only works with billing enabled on the key's Google project.
#   3. Pollinations: free, no key.
# Override the models with HF_IMAGE_MODEL / GEMINI_IMAGE_MODEL.
OPENAI_API_KEY=
OPENAI_IMAGE_GEN=off
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Reddit is currently on hold (API access blocked by policy changes) — all
# the code (feasibility signal + distribution channel) still exists, it's
# just skipped by default. Set ENABLE_REDDIT=true once creds are available
# again; until then these can stay blank.
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=ad-campaign-agent/0.1 by u/your_reddit_username
REDDIT_DEFAULT_SUBREDDIT=test

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon: feasibility's community signal (alongside Bluesky search). Both
# optional — search works unauthenticated against the public instance below;
# an access token (generate one in that instance's web UI, no review needed)
# upgrades it to more reliable full-text search.
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_TO_EMAIL=

# --- Optional paid tier (platform's own paid key; leave blank to stay fully free) ---
PAID_LLM_API_KEY=
PAID_IMAGE_API_KEY=
PAID_JUDGE_API_KEY=

# --- Distribution safety ---
# When true (default), distribution capabilities log what they WOULD send and
# make no real Bluesky/Reddit/email calls. Set to false to actually send.
DRY_RUN=true
# Base URL of the deployed Supabase `track-click` Edge Function
# (https://<project-ref>.supabase.co/functions/v1/track-click). Required only
# when send-email is called with a --cta-url.
TRACK_CLICK_BASE_URL=

# --- Supabase (M3+: campaigns/gates/iterations; M4+: multi-tenant with RLS) ---
SUPABASE_URL=
# Project Settings -> API -> "service_role" secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string (URI, "Transaction" or
# "Session" pooler mode both work) -- needs the DB password you set when
# creating the project, not any of the API keys above. Used by LangGraph's
# Postgres checkpointer (M5) so a campaign's paused/resumed state survives
# across separate GitHub Actions runs, which share nothing but this DB.
SUPABASE_DB_URL=

# --- Legacy BYOK encryption (M4) ---
# New BYOK keys go into Supabase Vault and don't use this. Only needed to read
# keys saved before the Vault move, until `python -m src.admin.migrate_keys_to_vault
# --apply` has moved them; then it can be removed.
SETTINGS_ENCRYPTION_KEY=

# --- Overrides ---
# Force free-tier providers even if paid keys above are set.
FORCE_FREE_TIER=false

# --- Observability (M6, optional) ---
# LangSmith free tier tracing. LangGraph picks these up automatically -- no
# code change needed. Leave TRACING_V2 false/blank to run with no tracing.
# If you want scheduled (GitHub Actions) runs traced too, add these same
# three as repo secrets and to campaign-loop.yml/capability-run.yml's env.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=marketingos

# --- Observability (optional, free tiers; see src/observability.py) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Send prompt/response text to Langfuse too (off: prompts carry customer content).
LANGFUSE_CAPTURE_CONTENT=false
