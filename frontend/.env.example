# Project Settings -> API -> "Project URL" and "anon public" key.
# Safe to expose in the browser bundle: every tenant table has row-level
# security (M4+), so the anon key only reaches the logged-in user's own rows.
# Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: browser error tracking (free Sentry plan). Leave empty to disable;
# the SDK isn't even downloaded then.
VITE_SENTRY_DSN=
